# GEMINI_API_KEY: Required if server-side Gemini AI API calls are used.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Firebase Authentication Configuration (Web SDK)
# Configure these values in your local .env file or Netlify environment settings
# to activate Firebase Email/Password and Google (Gmail) sign-in.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
